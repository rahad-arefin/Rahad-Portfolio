# rahadarefin.com server settings (Hostinger)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Always use https://rahadarefin.com (no "www", no plain http)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://rahadarefin.com%{REQUEST_URI} [L,R=301]

# /index.html should simply be /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]

# AI agents that ask for Markdown get the Markdown version of the same page
RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteRule ^$ /index.md [L]
RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteRule ^insights/([a-z0-9-]+)\.html$ /insights/$1.md [L]

# Never expose Git or config files
RedirectMatch 404 /\.git
RedirectMatch 404 /\.htaccess$

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

AddType text/markdown .md
AddCharset utf-8 .html .md .txt

<IfModule mod_headers.c>
  # Tell agents where the machine-readable versions live (RFC 8288)
  <FilesMatch "^index\.html$">
    Header set Link "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </index.md>; rel=\"alternate\"; type=\"text/markdown\""
  </FilesMatch>
  <FilesMatch "\.(html|md)$">
    Header append Vary Accept
  </FilesMatch>
  # Markdown answers are never cached, so a cache can never hand Markdown to a browser
  <FilesMatch "\.md$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType application/pdf "access plus 1 day"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/markdown text/plain text/css text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>
